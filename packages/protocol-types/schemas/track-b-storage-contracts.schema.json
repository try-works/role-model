          "type": "string",
          "format": "date-time"
        },
        "parity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceRows",
            "targetRows",
            "sourceHash",
            "targetHash",
            "passed"
          ],
          "properties": {
            "sourceRows": {
              "type": "integer",
              "minimum": 0
            },
            "targetRows": {
              "type": "integer",
              "minimum": 0
            },
