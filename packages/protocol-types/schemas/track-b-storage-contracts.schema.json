              "type": "string",
              "minLength": 32
            },
            "targetHash": {
              "type": "string",
              "minLength": 32
            },
            "passed": {
              "type": "boolean"
            }
          }
        },
        "rollbackTarget": {
          "$ref": "#/$defs/id"
        },
        "receiptIds": {
          "$ref": "#/$defs/idSet"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "runtimeChannel": {
          "enum": [
            "production",
            "stage",
            "development"
          ]
        },
        "scopeId": {
          "type": "string",
          "minLength": 1
        },
        "boundaryProtocolVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authorityState": {
                "enum": ["legacy_authoritative", "graph_shadow_mirror", "parity_verified"]
              }
            },
            "required": ["authorityState"]
          },
          "then": {
            "properties": {
              "activeWriter": { "const": "legacy_sqlite" }
            }
          },
          "else": {
            "properties": {
              "activeWriter": { "const": "artifact_graph" }
            }
          }
        }
      ]
    },
