      "default": "./dist/IndexedDbDatabase.js"
    },
    "./IndexedDbQueryBuilder": {
      "types": "./dist/types/IndexedDbQueryBuilder.d.ts",
      "import": "./dist/IndexedDbQueryBuilder.js",
      "default": "./dist/IndexedDbQueryBuilder.js"
    },
    "./IndexedDbTable": {
      "types": "./dist/types/IndexedDbTable.d.ts",
      "import": "./dist/IndexedDbTable.js",
      "default": "./dist/IndexedDbTable.js"
    },
    "./IndexedDbVersion": {
      "types": "./dist/types/IndexedDbVersion.d.ts",
      "import": "./dist/IndexedDbVersion.js",
      "default": "./dist/IndexedDbVersion.js"
