      "default": "./dist/BrowserWorker.js"
    },
    "./BrowserWorkerRunner": {
      "types": "./dist/types/BrowserWorkerRunner.d.ts",
      "import": "./dist/BrowserWorkerRunner.js",
      "default": "./dist/BrowserWorkerRunner.js"
    },
    "./Clipboard": {
      "types": "./dist/types/Clipboard.d.ts",
      "import": "./dist/Clipboard.js",
      "default": "./dist/Clipboard.js"
    },
    "./Geolocation": {
      "types": "./dist/types/Geolocation.d.ts",
      "import": "./dist/Geolocation.js",
      "default": "./dist/Geolocation.js"
