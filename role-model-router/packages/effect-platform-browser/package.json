{
  "name": "@role-model-router/effect-platform-browser",
  "version": "4.0.6",
  "private": true,
  "type": "module",
  "description": "First-party workspace build of vendored @effect/platform-browser 4.0.6 (vendor/effect/packages/platform/browser, source drop). Entries are derived from the vendored exports map; effect stays an external peer and no Node builtin enters the browser graph.",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./BrowserCrypto": {
      "types": "./dist/types/BrowserCrypto.d.ts",
      "import": "./dist/BrowserCrypto.js",
      "default": "./dist/BrowserCrypto.js"
    },
    "./BrowserHttpClient": {
      "types": "./dist/types/BrowserHttpClient.d.ts",
      "import": "./dist/BrowserHttpClient.js",
      "default": "./dist/BrowserHttpClient.js"
    },
    "./BrowserKeyValueStore": {
      "types": "./dist/types/BrowserKeyValueStore.d.ts",
      "import": "./dist/BrowserKeyValueStore.js",
      "default": "./dist/BrowserKeyValueStore.js"
    },
    "./BrowserPersistence": {
      "types": "./dist/types/BrowserPersistence.d.ts",
      "import": "./dist/BrowserPersistence.js",
      "default": "./dist/BrowserPersistence.js"
    },
    "./BrowserRuntime": {
      "types": "./dist/types/BrowserRuntime.d.ts",
      "import": "./dist/BrowserRuntime.js",
      "default": "./dist/BrowserRuntime.js"
    },
    "./BrowserSocket": {
      "types": "./dist/types/BrowserSocket.d.ts",
      "import": "./dist/BrowserSocket.js",
      "default": "./dist/BrowserSocket.js"
    },
    "./BrowserStream": {
      "types": "./dist/types/BrowserStream.d.ts",
