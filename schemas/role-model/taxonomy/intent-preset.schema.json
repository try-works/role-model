{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://role-model.dev/schemas/taxonomy/intent-preset.schema.json",
  "title": "Taxonomy Intent Preset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "label",
    "description",
    "expandsTo",
    "authority",
    "stability"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "kind": { "const": "intent_preset" },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "expandsTo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roleId": { "type": "string" },
        "taskType": { "type": "string" },
        "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
        "preferredCapabilities": { "type": "array", "items": { "type": "string" } },
        "requiredModalities": { "type": "array", "items": { "type": "string" } },
        "toolClasses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "owner"],
      "properties": {
        "scope": { "enum": ["core", "provider", "client", "org", "team", "user"] },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "stability": { "enum": ["stable", "experimental", "deprecated"] },
    "replacement": {
      "type": "string",
      "description": "When stability is deprecated, the ID of the replacement entry."
    },
    "deprecationReason": {
      "type": "string",
      "description": "Human-readable reason for deprecation."
    }
  }
}
