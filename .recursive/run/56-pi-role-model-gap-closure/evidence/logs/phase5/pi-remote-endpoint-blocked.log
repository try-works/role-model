const { spawn } = require('node:child_process');
const child = spawn('pi', ['--mode', 'rpc'], {
  shell: true,
  cwd: process.cwd(),
  env: { ...process.env, ROLE_MODEL_ENDPOINT: 'https://role-model.example.test' },
  stdio: ['pipe', 'pipe', 'pipe'],
});
let done = false;
function line(prefix, data) {
  for (const raw of data.toString().split(/\r?\n/)) {
    if (!raw) continue;
    console.log(prefix + raw);
    try {
      const parsed = JSON.parse(raw);
      if (parsed.type === 'response' && parsed.id === 'prompt') {
        done = true;
        child.kill('SIGTERM');
      }
    } catch {}
  }
}
child.stdout.on('data', (d) => line('', d));
child.stderr.on('data', (d) => line('STDERR ', d));
child.on('exit', (code, signal) => {
  console.log(`RPC_EXIT_CODE=${code}`);
  console.log(`RPC_SIGNAL=${signal}`);
});
setTimeout(() => {
  child.stdin.write(JSON.stringify({ id: 'prompt', type: 'prompt', message: '/role-model status' }) + '\n');
}, 500);
setTimeout(() => {
  if (!done) {
    console.log('TIMEOUT waiting for prompt response');
    child.kill('SIGTERM');
  }
}, 12000);
