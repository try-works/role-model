              <div className=\"flex flex-wrap items-center gap-2\">
                <span className={supportingTextClassName}>Reset to preset</span>
                {(Object.keys(SCORING_PRESETS) as ReadonlyArray<keyof typeof SCORING_PRESETS>).map(
