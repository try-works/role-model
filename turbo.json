{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig*.json", "role-model-router/tsconfig*.json"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", "build/**", ".react-router/**", "tsconfig.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:critical": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:critical:ci": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:router:ci": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "docs:taxonomy-v1-check": {
      "outputs": [],
      "cache": false
    }
  },
  "agentGuidance": false
}
